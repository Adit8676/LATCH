{
  "name": "latch-it",
  "version": "0.1.0",
  "description": "GitHub Desktop for AI agents — coordination, distributed file locks, and Mission Control.",
  "workspaces": [
    "mission-control"
  ],
  "bin": {
    "latch": "cli/latch.js",
    "latch-it": "cli/latch.js"
  },
  "files": [
    "cli",
    "backend",
    "hooks",
    "mission-control",
    "!mission-control/.next/cache",
    "!mission-control/.next/dev",
    "!mission-control/.next/diagnostics",
    "!mission-control/.next/types",
    "!mission-control/**/*.map",
    "!mission-control/**/*.tsbuildinfo",
    "!mission-control/node_modules",
    "README.md",
    "LICENSE",
    "latch-logo.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unknownsideofme/LATCH.git"
  },
  "keywords": [
    "ai",
    "agents",
    "coordination",
    "mutex",
    "file-locks",
    "mcp",
    "cursor",
    "claude-code",
    "antigravity",
    "codex",
    "copilot",
    "concurrency"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/unknownsideofme/LATCH/issues"
  },
  "homepage": "https://github.com/unknownsideofme/LATCH#readme",
  "scripts": {
    "build": "npm run build -w mission-control",
    "prepack": "npm run build",
    "dev": "concurrently -n api,ui -c cyan,magenta \"node backend/server.js --port 3001\" \"npm run dev -w mission-control\"",
    "dev:api": "node backend/server.js --port 3001",
    "dev:ui": "npm run dev -w mission-control",
    "start": "node backend/server.js --port 3001",
    "coordinator": "node backend/coordinator/server.js",
    "check:db": "node backend/supabase/check-connection.js",
    "test": "vitest run",
    "test:backend": "vitest run tests/backend",
    "test:backend:unit": "vitest run tests/backend/unit",
    "test:backend:e2e": "vitest run tests/backend/e2e",
    "test:mission-control": "vitest run tests/mission-control",
    "test:landing": "vitest run tests/landing",
    "test:unit": "vitest run tests/backend/unit tests/landing/unit tests/mission-control/unit",
    "test:e2e": "vitest run tests/backend/e2e tests/landing/e2e tests/mission-control/e2e",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@paypal/paypal-server-sdk": "^2.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@xyflow/react": "^12.11.3",
    "cors": "^2.8.5",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "lucide-react": "^1.64.0",
    "next": "^16.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^9.1.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
